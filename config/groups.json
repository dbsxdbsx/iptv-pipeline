    },
    "卫视": {
      "scope": "cn",
      "_note": "繁体变体必不可少：iptv-org 的中文频道一律用繁体，「北京衛視」不写进来就会漏成「其他」。",
      "match": ["卫视", "衛視"],
      "upstream": ["卫视频道", "卫视IPV4", "卫视高清"],
      "priority_names": [
